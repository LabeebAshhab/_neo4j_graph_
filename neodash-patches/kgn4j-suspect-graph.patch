+    const a = angle === undefined ? 0 : angle;
+    const start = kgnReach(node, fontSize, a) + 1.5;
+    const ex = x + Math.cos(a) * (start + w);
+    const ey = y + Math.sin(a) * (start + w);
+    x0 = Math.min(x0, ex);
+    x1 = Math.max(x1, ex);
