+
+// Click / hover area: the shape itself, so a whole box is clickable.
+export const kgnPointerArea = (node: any, color: string, ctx: any, fontSize: number) => {
+  if (kgnShape(node)) {
+    kgnTraceShape(node, ctx, fontSize);
+  } else {
+    ctx.beginPath();
+    ctx.arc(node.x || 0, node.y || 0, kgnRadius(node), 0, 2 * Math.PI, false);
+  }
+  ctx.fillStyle = color;
+  ctx.fill();
+};
+
+// Bounding box of a node including its outside label - used to fit the view.
+export const kgnExtent = (node: any, x: number, y: number, fontSize: number, outerProp?: string) => {
+  const [hw, hh] = kgnShape(node) ? kgnHalfSize(node, fontSize) : [kgnRadius(node), kgnRadius(node)];
+  let [x0, y0, x1, y1] = [x - hw, y - Math.max(hh, fontSize / 2), x + hw, y + Math.max(hh, fontSize / 2)];
+  const outer = outerProp && node.properties ? node.properties[outerProp] : undefined;
+  if (outer !== undefined && outer !== null && `${outer}` !== '') {
+    const sub = node.properties && node.properties.outer2 ? `${node.properties.outer2}` : '';
